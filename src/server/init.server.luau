local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local CameraShakeEffect = require(script.CameraEffect.CameraShakeEffect)
local InputSystem = require(script.InputSystem.InputSystem)
local Inventory = require(script.Inventory.Inventory)
local ItemCollector = require(script.ItemCollector.ItemCollector)
local MovementController = require(script.Movment.MovementController)
local TrashInitializer = require(script.Trash.TrashInitializer)
local UnpackableTrash = require(script.UsableItems.UnpackableTrash.UnpackableTrash)
local TrashBag = require(script.UsableItems.TrashBag.TrashBag)
local UsableItemsController = require(script.UsableItems.UsableItemsController)

InputSystem.init()
TrashInitializer.init()

Players.PlayerAdded:Connect(function(player: Player)
	UsableItemsController.new(player)
	ItemCollector.new(player)
	MovementController.initPlayer(player)

	player.CharacterAdded:Connect(function(character: Model)
		wait(1)
		local inventory = Inventory.new(player)
		TrashBag.new(workspace.TrashBag)
		TrashBag.new(workspace.TrashBag1)
		TrashBag.new(workspace.TrashBag2)
		TrashBag.new(workspace.TrashBag3)
		TrashBag.new(workspace.TrashBag4)
		local bigBox = UnpackableTrash.new(Workspace.CardboardBox, "bigBox", 6)
		local cardboard = UnpackableTrash.new(Workspace.Cardboard, "cardboard", 2)
	end)
end)

Players.PlayerRemoving:Connect(function(player: Player)
	UsableItemsController.getPlayerController(player):destroy()
	Inventory.getPlayerInventory(player):destroy()
end)
